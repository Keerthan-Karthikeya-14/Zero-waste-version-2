<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
    
    <display-name>Zero Waste Food Donation System</display-name>
    <description>AI Powered Food Donation & Rescue System</description>
    
    <!-- Welcome File List -->
    <welcome-file-list>
        <welcome-file>shared/pages/index.html</welcome-file>
    </welcome-file-list>
    
    <!-- Session Configuration -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <secure>false</secure>
        </cookie-config>
    </session-config>
    
    <!-- Error Pages -->
    <error-page>
        <error-code>404</error-code>
        <location>/shared/pages/index.html</location>
    </error-page>
    
    <error-page>
        <error-code>500</error-code>
        <location>/shared/pages/index.html</location>
    </error-page>
    
    <!-- Security Constraints (Basic) -->
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>Protected Pages</web-resource-name>
            <url-pattern>/admin/pages/*</url-pattern>
            <url-pattern>/donor/pages/*</url-pattern>
            <url-pattern>/receiver/pages/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>*</role-name>
        </auth-constraint>
    </security-constraint>
    
    <!-- Context Parameters -->
    <context-param>
        <param-name>db.url</param-name>
        <param-value>jdbc:mysql://localhost:3306/zerowaste_db</param-value>
    </context-param>
    
    <context-param>
        <param-name>db.username</param-name>
        <param-value>root</param-value>
    </context-param>
    
    <context-param>
        <param-name>db.password</param-name>
        <param-value></param-value>
    </context-param>
    
</web-app>
